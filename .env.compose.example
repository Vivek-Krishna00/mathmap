# Copy to .env.compose and fill in. Never commit the copy.
#
#   cp .env.compose.example .env.compose
#   sed -i '' "s|^MATHMAP_DB_PASSWORD=.*|MATHMAP_DB_PASSWORD=$(openssl rand -hex 16)|" .env.compose
#   sed -i '' "s|^MATHMAP_JWT_SECRET=.*|MATHMAP_JWT_SECRET=$(openssl rand -hex 32)|" .env.compose
#   npm run stack:up
#
# The MATHMAP_ prefix keeps these separate from the development .env, so a
# container can never pick up a development secret by accident.

MATHMAP_DB_PASSWORD=change-me
MATHMAP_JWT_SECRET=change-me

# Public origin users will hit — matters for CORS and for share links.
MATHMAP_CLIENT_ORIGIN=http://localhost:8080

# Host port to publish the app on.
MATHMAP_APP_PORT=8080

# 1 when something terminates TLS in front of the app (nginx, Cloudflare, a PaaS).
MATHMAP_TRUST_PROXY=1
