# Production build flags.
#
# Vite only reads .env.development in dev mode, which is why the demo sign-in chips
# were missing from the deployed site: the production bundle never saw the flag.
#
# WARNING: this repo deploys publicly, so this puts one-click admin access on a public
# URL. Set it to false (or delete the file) once the demo and viva are over, then
# redeploy. The service still works without it — sign in with the same addresses and
# the password mathmap123.
VITE_SHOW_DEMO_LOGINS=true
