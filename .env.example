# ------------------------------------------------------------------
# MathMap environment configuration
# Copy this file to `.env` and adjust values for your machine.
#   cp .env.example .env
# ------------------------------------------------------------------

# PostgreSQL connection string for the application database.
DATABASE_URL=postgres://localhost:5432/mathmap

# Secret used to sign JWT auth tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret-string

# How long issued tokens stay valid (e.g. 7d, 12h, 30m).
JWT_EXPIRES_IN=7d

# Port the Express API listens on.
PORT=4000

# Comma separated list of origins allowed to call the API (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Number of proxy hops to trust for the client IP (used by the rate limiter).
# Set this to 1 when running behind nginx / a PaaS load balancer, otherwise every
# client shares a single rate-limit bucket. Leave blank when the API is exposed
# directly, so clients cannot spoof X-Forwarded-For.
# TRUST_PROXY=1

# Node environment: development | production
NODE_ENV=development
